__pycache__/
*.pyc
.pytest_cache/
.review-deps/

# Local-only config overrides, never committed (SESSION_4_PLAN.md T0.1)
config.local.yaml

# RB-1: ephemeral per-process CSRF bearer token lockfile, never committed --
# regenerated fresh on every server startup.
harness/.harness_token.lock

# Build output and runtime SQLite DBs (SESSION_4_PLAN.md T0.2)
*.jar
harness/*.db
harness/run-output/

# Runtime SQLite DBs anywhere under testing/ (W-19): regenerable fixtures, and a
# captured target DB like helpdesk.db is a planted-vuln fixture, never source.
testing/**/*.db

# Stray runtime logs (server.log, tool logs) -- runtime artifacts, never source.
*.log

# score.py results (regenerable from the fixture)
testing/**/scorecard.json
testing/**/fixture/

# Captured eval corpora (regenerable via capture_exchanges.py against the
# committed app). Kept out of git: captures carry fixture session tokens/JWTs,
# and committing the tuned corpus is what would make the benchmark non-blind.
testing/**/corpus/

# Nightly CPU-only precision-plumbing check's output (P0.10, regenerated per CI run)
/SCORECARD.md

# Captured run artifacts can carry live target session tokens (JWTs/cookies) --
# keep them out of git so a browse/run capture never leaks a secret into history.
testing/**/run-*-results/
testing/**/exports/
testing/**/uploads/

# Local test environments and editable-install metadata
.venv*/
*.egg-info/

# Local Claude Code settings (personal, not committed)
.claude/settings.local.json

# External tooling checkouts + build/test caches (never source; these account
# for 31k+ untracked files -- competitor repos, a Go build cache, pytest temp
# dirs -- and must never be committed).
.audit-external/
*pytest-tmp/
live-*-pytest-tmp/
