{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-integrity-manifest/v1",
  "title": "AgenticVibe evaluation bundle manifest v1",
  "type": "object",
  "required": [
    "schema_version", "experiment_id", "invocation_id", "revision", "dirty_tree",
    "config_fingerprint", "corpus", "artifacts", "scoring_policy_version",
    "model_prompt", "evaluation_mode", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "evaluation-integrity-manifest/v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "dirty_tree": {"type": "boolean"},
    "config_fingerprint": {"type": "string", "minLength": 1},
    "corpus": {
      "type": "object",
      "required": ["identifier", "version"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256", "invocation_id"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "invocation_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "scoring_policy_version": {"type": "string", "minLength": 1},
    "model_prompt": {
      "type": "object", "required": ["relevant"],
      "properties": {
        "relevant": {"type": "boolean"},
        "model_id": {"type": "string"},
        "prompt_id": {"type": "string"}
      }
    },
    "evaluation_mode": {"enum": ["fresh_end_to_end", "historical_rescore"]},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
